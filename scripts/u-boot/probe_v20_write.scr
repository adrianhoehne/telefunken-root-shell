# ME211 v20 -- SCHREIBT apdat0 (neu gebautes /conf mit remote.txt).
# Erst Sicherung (v19) machen! CRC-Readback bestaetigt den Schreibvorgang.

echo ME211v20 begin

mw.l 0x3300000 0x4b4f564e
fatwrite usb 0:auto 0x3300000 me211v20_ran.bin 4

fatload usb 0:auto 0x3400000 conf_jb.ubifs
ubi part apdat0
ubi write 0x3400000 apdat0 0x326000

mw.l 0x3400000 0x00000000 1
ubi read 0x3400000 apdat0 0x326000
if crc32 0x3400000 0x326000 0x4a5b52ac; then
    echo ME211v20: VERIFIED
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 me211v20_ok.bin 4
else
    echo ME211v20: CRC MISMATCH
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 me211v20_FAIL.bin 4
fi

echo ME211v20 done
% <- this is end of file symbol
