# ME211 v9 -- READ ONLY. Test: braucht ubi read eine ganze LEB-Groesse?
# Fuellwort AAAA im Puffer: steht es im Dump, wurde nicht gelesen.

echo ME211v9 begin

mw.l 0x3300000 0x4b4f564e
fatwrite usb 0:auto 0x3300000 me211v9_ran.bin 4

ubi part fs0
mw.l 0x3400000 0x41414141
ubi read 0x3400000 ap0 0x40000
fatwrite usb 0:auto 0x3400000 me211v9_ap0_256k.bin 0x40000

mw.l 0x3500000 0x42424242
ubi read 0x3500000 fs0 0x40000
fatwrite usb 0:auto 0x3500000 me211v9_fs0_256k.bin 0x40000

echo ME211v9 done
% <- this is end of file symbol
