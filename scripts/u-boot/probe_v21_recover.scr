# ME211 v21 -- RECOVERY: schreibt /conf OHNE remote.txt zurueck.

echo ME211v21 begin

mw.l 0x3300000 0x4b4f564e
fatwrite usb 0:auto 0x3300000 me211v21_ran.bin 4

fatload usb 0:auto 0x3400000 conf_rec.ubifs
ubi part apdat0
ubi write 0x3400000 apdat0 0x326000

mw.l 0x3400000 0x00000000 1
ubi read 0x3400000 apdat0 0x326000
if crc32 0x3400000 0x326000 0x93978582; then
    echo ME211v21: VERIFIED
    mw.l 0x3300000 0x4b4f564e
    fatwrite usb 0:auto 0x3300000 me211v21_ok.bin 4
else
    echo ME211v21: CRC MISMATCH
    mw.l 0x3300000 0x4641494c
    fatwrite usb 0:auto 0x3300000 me211v21_FAIL.bin 4
fi

echo ME211v21 done
% <- this is end of file symbol
