# ME211 v17 -- READ ONLY. SPI + buffer + logo, vollstaendig.

echo ME211v17 begin

mw.l 0x3300000 0x4b4f564e
fatwrite usb 0:auto 0x3300000 me211v17_ran.bin 4

sf probe

sf read 0x3400000 0x0 0x200000
fatwrite usb 0:auto 0x3400000 me211v17_spi_0.bin 0x200000

sf read 0x3400000 0x200000 0x200000
fatwrite usb 0:auto 0x3400000 me211v17_spi_1.bin 0x200000

sf read 0x3400000 0x400000 0x200000
fatwrite usb 0:auto 0x3400000 me211v17_spi_2.bin 0x200000

sf read 0x3400000 0x600000 0x200000
fatwrite usb 0:auto 0x3400000 me211v17_spi_3.bin 0x200000

nand read 0x3400000 0x12480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v17_buffer_0.bin 0x2000000

nand read 0x3400000 0x14480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v17_buffer_1.bin 0x2000000

nand read 0x3400000 0x16480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v17_buffer_2.bin 0x2000000

nand read 0x3400000 0x18480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v17_buffer_3.bin 0x2000000

nand read 0x3400000 0x1a480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v17_buffer_4.bin 0x2000000

nand read 0x3400000 0x1c480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v17_buffer_5.bin 0x2000000

nand read 0x3400000 0x1e480000 0x1500000
fatwrite usb 0:auto 0x3400000 me211v17_buffer_6.bin 0x1500000

nand read 0x3400000 0x1f980000 0x400000
fatwrite usb 0:auto 0x3400000 me211v17_logo.bin 0x400000

echo ME211v17 done
% <- this is end of file symbol
