# ME211 v18 -- READ ONLY. apdat0 (korrigiert) + buffer.
# v15 hatte versehentlich 0x12480000 statt 0xFC80000 gelesen.

echo ME211v18 begin

mw.l 0x3300000 0x4b4f564e
fatwrite usb 0:auto 0x3300000 me211v18_ran.bin 4

nand read 0x3400000 0xfc80000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v18_apdat0_0.bin 0x2000000

nand read 0x3400000 0x11c80000 0x800000
fatwrite usb 0:auto 0x3400000 me211v18_apdat0_1.bin 0x800000

nand read 0x3400000 0x12480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v18_buffer_0.bin 0x2000000

nand read 0x3400000 0x14480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v18_buffer_1.bin 0x2000000

nand read 0x3400000 0x16480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v18_buffer_2.bin 0x2000000

nand read 0x3400000 0x18480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v18_buffer_3.bin 0x2000000

nand read 0x3400000 0x1a480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v18_buffer_4.bin 0x2000000

nand read 0x3400000 0x1c480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v18_buffer_5.bin 0x2000000

nand read 0x3400000 0x1e480000 0x1500000
fatwrite usb 0:auto 0x3400000 me211v18_buffer_6.bin 0x1500000

echo ME211v18 done
% <- this is end of file symbol
