# ME211 v12 -- READ ONLY. Raw dump of the ap0 partition, blocks 0-3 (128 MB).
# Raw means: physical PEB order with UBI EC/VID headers, so unblob can
# reassemble the volume. Takes several minutes.

echo ME211v12 begin

mw.l 0x3300000 0x4b4f564e
fatwrite usb 0:auto 0x3300000 me211v12_ran.bin 4

nand read 0x3400000 0x3480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v12_ap0raw_0.bin 0x2000000

nand read 0x3400000 0x5480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v12_ap0raw_1.bin 0x2000000

nand read 0x3400000 0x7480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v12_ap0raw_2.bin 0x2000000

nand read 0x3400000 0x9480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v12_ap0raw_3.bin 0x2000000

echo ME211v12 done
% <- this is end of file symbol
