# ME211 v15 -- READ ONLY. Raw dump of apdat0 (/conf, 40 MB).

echo ME211v15 begin

mw.l 0x3300000 0x4b4f564e
fatwrite usb 0:auto 0x3300000 me211v15_ran.bin 4

nand read 0x3400000 0x12480000 0x2000000
fatwrite usb 0:auto 0x3400000 me211v15_apdat0raw_0.bin 0x2000000

nand read 0x3400000 0x14480000 0x800000
fatwrite usb 0:auto 0x3400000 me211v15_apdat0raw_1.bin 0x800000

echo ME211v15 done
% <- this is end of file symbol
